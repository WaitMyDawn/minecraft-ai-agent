# ============================================================
# MAA 环境变量模板
#
#   复制这份文件为 .env 再填真实值：cp .env.example .env
#   本地运行时 .env 由程序自己在启动时加载（见 MinecraftAiAgentApplication）。
#   Docker 部署时走 docker-compose 的 env_file，改完必须 `docker compose up -d`
#   —— `restart` 不会重读 .env。
#
#   ⚠️ 这个文件会进 git，所以这里只放占位符。
#      真实的 .env / 任何含密钥的 env 文件都已被 .gitignore 覆盖，别用 -f 强行提交。
# ============================================================

# ---------- 必需 ----------

# 加密用户个人 API Key 的密钥种子。生成：openssl rand -base64 32
# ⚠️ 这个值一旦丢失，库里所有用户的 API Key 密文都无法解开（用户必须重填），
#    请单独离线备份，并且不要和数据库备份放在同一台机器上。
MAA_ENCRYPTION_SECRET=replace-with-openssl-rand-base64-32

# 是否开放公开注册。内测期间建议 false；本地自用可设 true。
MAA_ALLOW_REGISTRATION=false

# 系统默认 LLM Key（可选）。留空时用户必须自己配置 Key。
# 填入后，未配置个人 Key 的用户也能用，费用算在这个 Key 上。
DEEPSEEK_API_KEY=

# ---------- 账号与会话 ----------

# 登录令牌的空闲有效期（天）。滑动续期：一直在用就不会被踢下线。
MAA_SESSION_TTL_DAYS=30

# ---------- 运维端点 ----------

# 运维端点口令（在线备份 / 发信自检 / 邮件通道状态）。为空 = 端点当作不存在（404）。
# 生成：openssl rand -hex 24
MAA_OPS_TOKEN=

# 在线备份的落盘目录（默认在 maa_db 下，宿主机可直接取走）
MAA_OPS_BACKUP_DIR=maa_db/backups

# ---------- 邮件 ----------

# 总开关。false 时注册/找回密码会明确回"邮件服务未启用"，而不是抛 500。
MAA_MAIL_ENABLED=false

# 生效通道：resend（推荐，域名验证后免逐个验证发件人）
#            brevo（额度可查，但注册需手机核验）
#            smtp（阿里云 DirectMail / QQ / 163，零注册成本）
MAA_MAIL_PROVIDER=resend

# 收件人看到的发件人名字
MAA_MAIL_FROM_NAME=MAA

# --- Resend（HTTP API，当前默认通道）
# 控制台 → API Keys 创建（建议权限限制为 Sending access 并锁定到发信子域）
# 发件人必须是**已验证域名**下的地址；Resend 不提供额度查询接口，发满额度会返回 429。
MAA_RESEND_API_KEY=
MAA_RESEND_FROM=noreply@send.example.com
MAA_RESEND_FROM_NAME=MAA

# --- Brevo（HTTP API，额度可查）
MAA_BREVO_API_KEY=
MAA_BREVO_FROM=noreply@example.com
MAA_BREVO_FROM_NAME=MAA
# 额度查询结果的缓存时长（每次发信都问一次太浪费）
MAA_BREVO_QUOTA_CACHE_MS=300000

# --- SMTP（阿里云 DirectMail / QQ / 163）
# 云厂商默认封 25 端口，用 465(SSL)。
# QQ/163 这里填"授权码"而不是邮箱登录密码；用 QQ 时 MAA_MAIL_FROM 必须与 USERNAME 完全一致。
MAA_MAIL_HOST=smtpdm.aliyun.com
MAA_MAIL_PORT=465
MAA_MAIL_USERNAME=
MAA_MAIL_PASSWORD=
MAA_MAIL_FROM=

# 验证码限流：同一邮箱每天最多收到几个码（注册/改密码/换绑共用额度）+ 两次发送的最小间隔
MAA_EMAIL_CODE_MAX_PER_DAY=3
MAA_EMAIL_CODE_COOLDOWN_MS=60000

# 验收专用：true 时每次发信都按"额度用完"失败（不真发信），用来验证提示文案。生产保持 false。
# MAA_MAIL_SIMULATE_QUOTA=false

# ---------- 检索与限流 ----------

# 服务器出网的全局令牌闸（Modrinth 实测限额约 300 次/分钟/IP，默认留了余量）
MAA_MODRINTH_RATE_PER_MINUTE=240
MAA_MODRINTH_BURST=40
MAA_MODRINTH_MAX_WAIT_MS=30000

# 是否把查模组/查版本的请求下放给用户浏览器直连 Modrinth
MAA_DELEGATION_ENABLED=true
MAA_DELEGATION_PER_CALL_BUDGET_MS=30000

# ---------- 日志 ----------

# 日志目录（默认与 maa_db 同级 ./logs；容器内建议 /app/logs 并挂载卷）
# LOG_DIR=
# 日志保留天数，默认 14，会自动清理过期的日期目录
# LOG_RETENTION_DAYS=14
